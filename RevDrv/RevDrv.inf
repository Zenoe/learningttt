;
; RevDrv.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = RevDrv.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
RevDrv.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%RevDrv.DeviceDesc% = RevDrv_Device, Root\RevDrv ; TODO: edit hw-id

[RevDrv_Device.NT]
CopyFiles = File_Copy

[File_Copy]
RevDrv.sys

;-------------- Service installation
[RevDrv_Device.NT.Services]
AddService = RevDrv,%SPSVCINST_ASSOCSERVICE%, RevDrv_Service_Inst

; -------------- RevDrv driver install sections
[RevDrv_Service_Inst]
DisplayName    = %RevDrv.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\RevDrv.sys

[RevDrv_Device.NT.Wdf]
KmdfService = RevDrv, RevDrv_wdfsect

[RevDrv_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "RevDrv Installation Disk"
RevDrv.DeviceDesc = "RevDrv Device"
RevDrv.SVCDESC = "RevDrv Service"
